# Public website settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Put the sb_publishable_... key here (or legacy anon key). Code retains ANON_KEY for compatibility.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only sb_secret_... key (or legacy service_role key). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary signed uploads (API secret is server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sharma-aluminium-master

# Resend email notifications (optional until verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=sharmaaluminium.1970@gmail.com

# OpenAI-compatible chat completions provider (optional)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional verification / external links
NEXT_PUBLIC_GOOGLE_MAPS_PLACE_URL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_WHATSAPP_DEFAULT_CONTACT=9988257900
